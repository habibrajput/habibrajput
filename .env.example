# Gmail account the contact form sends from (e.g. you@gmail.com)
GMAIL_USER=
# 16-character Google App Password (NOT your normal Gmail password)
GMAIL_APP_PASSWORD=
# Where contact form messages are delivered (defaults to GMAIL_USER)
CONTACT_TO_EMAIL=
# Optional: your live site URL, used for SEO when not hosting on Vercel
NEXT_PUBLIC_SITE_URL=
